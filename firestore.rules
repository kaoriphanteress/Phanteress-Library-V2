rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // User watchlist / library items
      match /watchlist/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }

      // User episode tracking
      match /episodes/{episodeId} {
        allow read, write: if isOwner(userId) && isValidId(episodeId);
      }
    }
  }
}
